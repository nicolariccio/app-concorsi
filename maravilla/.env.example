# Database (Supabase, regione UE). Senza queste, in sviluppo i dati stanno in .dati/dati.json;
# in produzione il sito mostra le pagine vuote e rifiuta le prenotazioni.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Pannello /admin: senza entrambe nessuno può entrare.
ADMIN_PASSWORD=          # almeno 8 caratteri
SESSION_SECRET=          # almeno 16 caratteri casuali (es. openssl rand -hex 32)

# Solo prove locali con "next start": salva i dati in .dati/dati.json invece che su Supabase.
# DATI_SU_FILE=1

# Email al gestore per ogni nuova prenotazione (facoltativo, servizio Resend).
RESEND_API_KEY=
NOTIFICA_EMAIL=          # dove ricevere gli avvisi; con il mittente di prova deve essere l'email dell'account Resend
# EMAIL_MITTENTE="Maravilla <prenotazioni@tuodominio.it>"   # solo dopo aver verificato un dominio su Resend
